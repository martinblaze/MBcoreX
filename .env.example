# Resend (https://resend.com) — required for the contact form to actually send email.
# Without these set, submissions are logged server-side only (see actions/contact.ts).
RESEND_API_KEY=
# Must be an address on a domain verified with Resend, e.g. "MB CoreX <hello@mbcorex.com>"
CONTACT_FROM_EMAIL=

# Production site URL — used to build canonical/OG URLs and JSON-LD (lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://mbcorex.com

# Analytics/tracking — every one of these is a no-op until set (lib/analytics.ts).
# Fill in only the integrations you're actually using.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
